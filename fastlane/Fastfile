# Releases of AgentTerm.
#
#   ios beta      build the iPhone app and upload it to TestFlight
#   ios build     the same without the upload, to check signing
#   ios screenshots   upload the App Store screenshots in fastlane/screenshots
#   mac release   build AgentTerm.app, sign it with Developer ID, notarize it, make a .dmg
#   mac sign      the same without notarizing, to check signing
#
# Run them through scripts/release.sh, which reads the secrets these lanes
# need from the private dotfiles repo. Nothing secret is in this file.
#
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH   App Store Connect API key
#   APPLE_TEAM_ID                             the developer team
#   MATCH_GIT_URL, MATCH_PASSWORD             fastlane match (iPhone)
#   DEVELOPER_ID_P12, DEVELOPER_ID_P12_PASSWORD   Developer ID certificate (Mac)

require "fileutils"
require "tmpdir"

APP_ID = "com.manhpham.agentterm".freeze
ROOT = File.expand_path("..", __dir__).freeze
DIST = File.join(ROOT, "dist").freeze

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

# "0.2.0", from the VERSION file unless the environment says otherwise.
def app_version
  return ENV["VERSION"] unless ENV["VERSION"].to_s.empty?

  File.read(File.join(ROOT, "VERSION")).strip
end

# Release notes as the plain text TestFlight shows: no Markdown marks, and
# within the 4000 characters it allows.
def what_to_test(markdown)
  text = markdown.gsub(/^\#{1,6}\s*/, "").gsub(/\*\*(.+?)\*\*/, '\1').gsub(/`([^`]*)`/, '\1')
  text = text.gsub(/\[([^\]]+)\]\(([^)]+)\)/, '\1 (\2)').gsub(/^- /, "• ")
  text.strip[0, 4000]
end

platform :ios do
  desc "Build the iPhone app, signed for the App Store"
  lane :build do |options|
    # On a CI runner: a keychain for the run, which match fills. Does nothing elsewhere.
    setup_ci
    key = asc_key
    team = ENV.fetch("APPLE_TEAM_ID")
    # The Firebase config file goes into the app for this build only. Without
    # one the app reports nothing.
    firebase = File.join(ROOT, "iOS/AgentTerm/GoogleService-Info.plist")
    FileUtils.rm_f(firebase)
    FileUtils.cp(ENV["FIREBASE_CONFIG_IOS"], firebase) unless ENV["FIREBASE_CONFIG_IOS"].to_s.empty?
    Dir.chdir(File.join(ROOT, "iOS")) { sh("xcodegen", "generate") }

    # `create:true` lets match make the provisioning profile the first time.
    # Otherwise it only reads what the match repository already holds.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      api_key: key,
      team_id: team,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      readonly: !options[:create]
    )
    profile = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")

    # The project is generated, so signing is set on it here, on the app
    # alone: the Swift packages it builds must not get a profile.
    update_code_signing_settings(
      path: File.join(ROOT, "iOS/AgentTerm.xcodeproj"),
      targets: ["AgentTerm"],
      use_automatic_signing: false,
      team_id: team,
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )

    number = options[:build_number] ||
             latest_testflight_build_number(api_key: key, app_identifier: APP_ID, version: app_version, initial_build_number: 0) + 1
    build_app(
      project: File.join(ROOT, "iOS/AgentTerm.xcodeproj"),
      scheme: "AgentTerm",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile } },
      xcargs: "MARKETING_VERSION=#{app_version} CURRENT_PROJECT_VERSION=#{number} -skipPackagePluginValidation",
      output_directory: DIST,
      output_name: "AgentTerm.ipa"
    )
  end

  desc "Upload the App Store screenshots in fastlane/screenshots"
  lane :screenshots do
    upload_to_app_store(
      api_key: asc_key,
      app_identifier: APP_ID,
      screenshots_path: File.join(ROOT, "fastlane/screenshots"),
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "Send the App Store listing in fastlane/metadata to App Store Connect"
  lane :metadata do
    # Name, subtitle, description, keywords, URLs, categories and the notes
    # for App Review. "What's New" is the version's release notes. Nothing is
    # submitted for review; the screenshots have a lane of their own.
    notes = File.join(ROOT, "packaging/release-notes/v#{app_version[/^[\d.]+/]}.md")
    # App Store Connect takes the contact for App Review only with a phone
    # number, which is not kept in the repository. Without
    # review_information/phone_number.txt that folder is left out, and what
    # App Store Connect has for App Review stays as it is.
    listing = File.join(Dir.mktmpdir, "metadata")
    FileUtils.cp_r(File.join(ROOT, "fastlane/metadata"), listing)
    FileUtils.rm_rf(File.join(listing, "review_information")) unless File.size?(File.join(listing, "review_information/phone_number.txt"))
    upload_to_app_store(
      api_key: asc_key,
      app_identifier: APP_ID,
      app_version: app_version[/^[\d.]+/],
      metadata_path: listing,
      release_notes: File.size?(notes) ? { "en-US" => what_to_test(File.read(notes)) } : nil,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "Build the iPhone app and upload it to TestFlight"
  lane :beta do |options|
    build(options)
    # "What to Test" is the version's release notes. TestFlight takes them
    # only once it has processed the build, so the lane waits for that when
    # there are notes; NOTES=0 uploads and leaves at once.
    notes = File.join(ROOT, "packaging/release-notes/v#{app_version[/^[\d.]+/]}.md")
    with_notes = File.size?(notes) && ENV["NOTES"] != "0"
    upload_to_testflight(
      api_key: asc_key,
      ipa: File.join(DIST, "AgentTerm.ipa"),
      skip_waiting_for_build_processing: !with_notes,
      distribute_external: false,
      changelog: with_notes ? what_to_test(File.read(notes)) : nil
    )
  end
end

platform :mac do
  desc "Build AgentTerm.app and sign it with Developer ID"
  lane :sign do
    version = app_version
    app = File.join(DIST, "AgentTerm.app")
    dmg = File.join(DIST, "AgentTerm-#{version}.dmg")
    Dir.chdir(ROOT) { sh({ "VERSION" => version, "CONFIG" => "release", "CHANNEL" => "release" }, "./scripts/bundle-mac.sh") }

    # The certificate goes into a keychain of its own for the length of the
    # run, so the login keychain is left as it was.
    keychain = "agentterm-release"
    password = SecureRandom.hex(16)
    delete_keychain(name: keychain) if File.exist?(File.expand_path("~/Library/Keychains/#{keychain}-db"))
    create_keychain(name: keychain, password: password, unlock: true, timeout: 3600, add_to_search_list: true, default_keychain: false)
    begin
      import_certificate(
        certificate_path: ENV.fetch("DEVELOPER_ID_P12"),
        certificate_password: ENV["DEVELOPER_ID_P12_PASSWORD"].to_s,
        keychain_name: keychain,
        keychain_password: password
      )
      path = File.expand_path("~/Library/Keychains/#{keychain}-db")
      identity = sh("security", "find-identity", "-v", "-p", "codesigning", path, log: false)[/"(Developer ID Application: [^"]+)"/, 1]
      UI.user_error!("No Developer ID Application certificate in #{ENV['DEVELOPER_ID_P12']}") unless identity

      # Inside out: the daemon, then the app around it. The hardened runtime
      # and a timestamp are what notarization asks for.
      # The entitlements are what lets a program in a session ask for
      # things such as scripting another app; see the file.
      entitlements = File.join(ROOT, "assets/AgentTerm.entitlements")
      flags = ["--force", "--options", "runtime", "--timestamp", "--entitlements", entitlements, "--keychain", path, "--sign", identity]
      sh("codesign", *flags, File.join(app, "Contents/MacOS/agenttermd"))
      sh("codesign", *flags, app)
      sh("codesign", "--verify", "--deep", "--strict", "--verbose=2", app)

      # The disk image holds the app and a shortcut to Applications, so
      # installing is dragging one onto the other.
      FileUtils.rm_f(dmg)
      Dir.mktmpdir("agentterm-dmg") do |staging|
        sh("ditto", app, File.join(staging, "AgentTerm.app"), log: false)
        File.symlink("/Applications", File.join(staging, "Applications"))
        sh("hdiutil", "create", "-volname", "AgentTerm", "-srcfolder", staging, "-ov", "-format", "UDZO", dmg, log: false)
      end
      sh("codesign", "--force", "--timestamp", "--keychain", path, "--sign", identity, dmg)
    ensure
      delete_keychain(name: keychain)
    end
    UI.success("Signed #{dmg}")
    dmg
  end

  desc "Build, sign and notarize AgentTerm for download outside the App Store"
  lane :release do
    dmg = sign
    # Uploads the disk image to Apple's notary service, waits for the
    # verdict and staples the ticket to it.
    notarize(package: dmg, api_key: asc_key, print_log: true)
    sh("spctl", "--assess", "--type", "open", "--context", "context:primary-signature", "--verbose=2", dmg)
    UI.success("Notarized #{dmg}")
  end
end
